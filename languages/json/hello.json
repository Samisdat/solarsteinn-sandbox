      { "id": 1, "tags": ["a", "b"] },
      { "id": 2, "tags": [] },
      { "id": 3, "tags": ["c"], "extra": {} }
    ]
  },
  "escapes": "tab\there\nnewline\r\nand a slash \/ too",
